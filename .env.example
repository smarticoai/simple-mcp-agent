# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-2.5-flash

# URL of the running Smartico MCP server
SMARTICO_MCP_URL=

# Token for MCP authentication
SMARTICO_MCP_TOKEN=your-mcp-bearer-token-here
